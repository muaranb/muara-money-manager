# Turso Database Configuration (libSQL Edge)
# For local development without Turso cloud: "file:local.db"
# For production Turso cloud: "libsql://[your-db-name]-[your-org].turso.io"
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
