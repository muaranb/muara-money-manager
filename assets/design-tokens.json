{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Muara Money Manager Design Tokens",
  "version": "1.0.0",
  "description": "Three-layer design tokens for Muara Money Manager: Primitives -> Semantic OKLCH -> Component",
  "primitives": {
    "color": {
      "obsidian": {
        "950": "#030712",
        "900": "#0a0e1a",
        "850": "#0f172a",
        "800": "#1e293b"
      },
      "emerald": {
        "400": "#34D399",
        "500": "#10B981",
        "600": "#059669"
      },
      "rose": {
        "400": "#FB7185",
        "500": "#F43F5E",
        "600": "#E11D48"
      },
      "indigo": {
        "400": "#818CF8",
        "500": "#6366F1",
        "600": "#4F46E5"
      },
      "gold": {
        "400": "#FBBF24",
        "500": "#F59E0B",
        "600": "#D97706"
      },
      "slate": {
        "100": "#F1F5F9",
        "200": "#E2E8F0",
        "400": "#94A3B8",
        "500": "#64748B",
        "700": "#334155"
      },
      "white": "#FFFFFF"
    },
    "typography": {
      "fontSans": "'Geist Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "fontMono": "'JetBrains Mono', 'Geist Mono', monospace"
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px",
      "2xl": "48px"
    },
    "radii": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "xl": "24px",
      "full": "9999px"
    }
  },
  "semantic": {
    "color": {
      "background": "oklch(0.12 0.015 260)",
      "foreground": "oklch(0.98 0.005 260)",
      "card": "oklch(0.16 0.02 260 / 0.75)",
      "cardForeground": "oklch(0.98 0.005 260)",
      "cardBorder": "oklch(1 0 0 / 0.08)",
      "cardBorderHover": "oklch(1 0 0 / 0.18)",
      "income": "oklch(0.72 0.17 155)",
      "incomeGlow": "oklch(0.72 0.17 155 / 0.18)",
      "expense": "oklch(0.65 0.22 15)",
      "expenseGlow": "oklch(0.65 0.22 15 / 0.18)",
      "transfer": "oklch(0.65 0.18 275)",
      "transferGlow": "oklch(0.65 0.18 275 / 0.18)",
      "primary": "oklch(0.75 0.16 85)",
      "primaryForeground": "oklch(0.12 0.015 260)",
      "muted": "oklch(0.20 0.02 260 / 0.8)",
      "mutedForeground": "oklch(0.65 0.02 260)",
      "border": "oklch(0.28 0.02 260 / 0.45)",
      "ring": "oklch(0.72 0.17 155 / 0.5)"
    }
  },
  "components": {
    "bentoCard": {
      "background": "var(--card)",
      "border": "1px solid var(--card-border)",
      "boxShadow": "inset 0 1px 0 0 rgba(255, 255, 255, 0.06), 0 8px 32px 0 rgba(0, 0, 0, 0.4)",
      "borderRadius": "var(--radii-lg)",
      "transition": "all 200ms cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "tabularCurrency": {
      "prefixColor": "var(--muted-foreground)",
      "integerColor": "var(--foreground)",
      "centsColor": "var(--muted-foreground)",
      "fontFamily": "var(--font-mono)"
    },
    "bankCard": {
      "mandiri": {
        "gradient": "linear-gradient(135deg, #0d1e3a 0%, #162d55 50%, #0a1527 100%)",
        "chipColor": "#d4af37"
      },
      "bca": {
        "gradient": "linear-gradient(135deg, #081b3b 0%, #040d1e 100%)",
        "borderColor": "rgba(212, 175, 55, 0.3)"
      },
      "dana": {
        "gradient": "linear-gradient(135deg, #08355b 0%, #0b223d 100%)",
        "glowColor": "rgba(17, 142, 234, 0.25)"
      },
      "cash": {
        "gradient": "linear-gradient(135deg, #0d2319 0%, #06120d 100%)",
        "accentColor": "#10B981"
      }
    },
    "contraTether": {
      "badgeBackground": "rgba(99, 102, 241, 0.12)",
      "badgeBorder": "rgba(99, 102, 241, 0.35)",
      "textColor": "var(--transfer)",
      "highlightBorder": "rgba(99, 102, 241, 0.6)"
    }
  }
}
